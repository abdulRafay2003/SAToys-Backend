# ============================================
# LUMO Backend — Environment Variables
# ============================================
# cp .env.example .env  then fill in.
# NEVER commit .env.
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# Absolute base used to build URLs for uploaded files.
PUBLIC_URL=http://localhost:5000

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/lumo
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/lumo?retryWrites=true&w=majority

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters or the server refuses to boot.
JWT_SECRET=replace_me_with_a_32_char_or_longer_random_string
JWT_EXPIRE=7d

# --- Clients ---
# Storefront (Toys-Website) and admin (Toys-Admin). Comma-separated CORS allow-list.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Uploads ---
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_FILES=12

# --- Email (optional in development) ---
# Leave EMAIL_HOST blank and OTP/reset codes are logged to the console instead.
# Gmail needs an App Password, not your account password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=LUMO
