# ============================================
# SA Toys API — Environment Variables
# ============================================
# cp .env.example .env  then fill in.
# NEVER commit .env.
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# Absolute base used to build URLs for uploaded files.
PUBLIC_URL=http://localhost:5000

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/lumo
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/lumo?retryWrites=true&w=majority

# --- Auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters or the server refuses to boot.
JWT_SECRET=replace_me_with_a_32_char_or_longer_random_string
JWT_EXPIRE=7d

# --- Clients ---
# Storefront and admin. Comma-separated CORS allow-list — every browser origin
# that calls this API must appear here or requests fail in the browser (Postman
# still works because it sends no Origin header).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Production (Hostinger):
# CORS_ORIGINS=https://www.satoys.store,https://satoys.store,https://admin.satoys.store
# STOREFRONT_URL=https://www.satoys.store
# ADMIN_URL=https://admin.satoys.store
# PUBLIC_URL=https://api.satoys.store

# --- Uploads ---
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_FILES=12

# --- Email (optional in development) ---
# Sent via Brevo's HTTP API, not SMTP — leave BREVO_API_KEY blank and OTP/reset
# codes are logged to the console instead.
BREVO_API_KEY=
# Must be a sender verified in Brevo (Settings -> Senders & IP).
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SA Toys

# ============================================
# Image storage
# ============================================
# 'local' writes to ./uploads and serves them from this API — development only.
# On Hostinger the app folder is replaced on every deployment, so production
# uses 'hostinger': files go into the separate media site's web root.
# ('hostinger-http' writes the same folder via its PHP receiver — the fallback
#  if the Node app can't write there.)
STORAGE_DRIVER=local

# Hostinger media site — see hostinger/media/README.md.
# Public base the files are served from:
MEDIA_PUBLIC_URL=https://media.satoys.store
# STORAGE_DRIVER=hostinger: absolute path to that site's web root (hPanel → File Manager shows it):
MEDIA_ROOT=/home/u123456789/domains/media.satoys.store/public_html
# STORAGE_DRIVER=hostinger-http only: receiver URL and its secret (32+ chars,
# must match `secret` in media-config.php on the server).
MEDIA_UPLOAD_URL=https://media.satoys.store/_upload/
MEDIA_UPLOAD_SECRET=

# Storefront cache invalidation. Both must be set for admin writes to push an
# invalidation; unset means the storefront falls back to its 60s revalidate floor.
STOREFRONT_REVALIDATE_URL=https://yourdomain.com/api/revalidate
REVALIDATE_SECRET=change_me_to_32_random_hex_chars
